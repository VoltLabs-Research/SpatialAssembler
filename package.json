{
  "name": "@voltstack/spatial-assembler",
  "version": "2.0.0",
  "description": "Encoder and decoder of the quantized, meshopt-compressed glTF models VOLT stores.",
  "private": false,
  "gypfile": true,
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "binding.gyp",
    "index.js",
    "index.d.ts",
    "src/*.h",
    "src/glb_core.cpp",
    "src/node_binding.cpp",
    "third_party/**/*",
    "prebuilds/**/*",
    "LICENSE"
  ],
  "scripts": {
    "install": "node-gyp-build",
    "prebuild": "prebuildify --napi --strip",
    "test": "node --test test/roundtrip.test.mjs"
  },
  "devDependencies": {
    "node-gyp": "^10.0.0",
    "prebuildify": "^6.0.1"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoltLabs-Research/SpatialAssembler.git"
  },
  "types": "index.d.ts"
}
